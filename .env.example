BOT_NAME=MiBot
DEFAULT_RESPONSE=Gracias por tu mensaje. Estoy usando un bot automatizado.
LOG_LEVEL=info
AUTH_DIR=auth_info
RESET_WHATSAPP_SESSION=false

# false en producción: si se deja en true, el bot responde a tus propios
# mensajes (útil solo para pruebas hablándote a ti mismo).
TEST_MODE_SELF_CHAT=false

# Enlace de invitación al grupo de WhatsApp que se envía cuando alguien
# escribe "grupo" al iniciar una conversación.
GROUP_INVITE_URL=https://chat.whatsapp.com/TU_ENLACE_AQUI

# Opcional: número/dispositivo aparte para asesores, formato "57300...@c.us".
# Si se deja vacío, el resumen de cada cliente escalado llega a tu propio
# chat ("Mensajes a mí mismo"), ya que hoy solo hay un número para todo.
ADVISOR_WHATSAPP_NUMBER=

# Panel de administración web (npm run dashboard -> http://localhost:4321).
# Define tu propio usuario/clave; DASHBOARD_SESSION_SECRET puede ser
# cualquier texto largo al azar (se usa para firmar la cookie de sesión).
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=
DASHBOARD_PORT=4321
DASHBOARD_SESSION_SECRET=
